# Server only. Never prefix a secret with VITE_.
MODEL_API_KEY=
# Confirm this variant is covered by your grant before enabling calls.
META_MODEL=muse-spark-1.3-contributor
# Explicit opt-in to credit-consuming calls. Defaults to false.
META_ENABLED=false
PORT=5187

# Optional: use 0.0.0.0 to allow devices on your trusted local network.
HOST=127.0.0.1

# Hosted demo: HTTPS origin, e.g. https://your-app.onrender.com.
# Render supplies RENDER_EXTERNAL_URL automatically; no PUBLIC_ORIGIN needed there.
PUBLIC_ORIGIN=
# The entire app and API require these credentials when a password is set.
# Public hosting refuses to start without a password of at least 16 characters.
SARI_DEMO_USER=sari
SARI_DEMO_PASSWORD=
